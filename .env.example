# Environment Variables
# Copy this file to .env and fill in the values

# Database - SQLite file path (relative to prisma directory)
DATABASE_URL="file:./dev.db"

# Session password - MUST be at least 32 characters
# Generate a random one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD="change-this-to-a-random-string-at-least-32-characters-long-for-production"

# ===================================================
# Cafe POS Environment Variables Template
# Copy this file to .env and customize your values
# ===================================================

# Database - SQLite file path (relative to prisma directory)
DATABASE_URL="file:./dev.db"

# Session encryption secret - MUST be at least 32 characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD="your-strong-random-session-secret-at-least-32-chars"

# Optional AES-256 field encryption key (defaults to SESSION_PASSWORD)
ENCRYPTION_KEY="your-strong-random-field-encryption-key-32-chars"

# Initial Administrator Provisioning for 'npm run seed:admin'
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choose-your-secure-admin-password"
ADMIN_NAME="Cafe Administrator"
CAFE_NAME="My Cafe"
